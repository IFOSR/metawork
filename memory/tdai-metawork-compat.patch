+  private async handleMetaWorkProfileQuery(req: http.IncomingMessage, res: http.ServerResponse): Promise<void> {
+    const body = await parseJsonBody<MetaWorkScopeBody & { limit?: number; offset?: number }>(req);
+    const scope = readMetaWorkScope(body);
