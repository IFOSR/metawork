+      content: row.content,
+      background: null,
+      created_at: row.created_time,
+      updated_at: row.updated_time,
+    }));
+    this.sendMetaWorkResponse(res, { items, total: rows.length });
+  }
+
+  private async handleMetaWorkAtomicUpdate(
