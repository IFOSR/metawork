+  private async handleMetaWorkScenarioSearch(req: http.IncomingMessage, res: http.ServerResponse): Promise<void> {
+    const body = await parseJsonBody<MetaWorkScopeBody & { query?: string; limit?: number }>(req);
+    const scope = readMetaWorkScope(body);
+    if (!scope || typeof body.query !== "string") {
+      sendError(res, 400, "memory_scenario_search_invalid");
+      return;
