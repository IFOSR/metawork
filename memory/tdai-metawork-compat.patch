+  private async handleMetaWorkAtomicUpdate(
+    req: http.IncomingMessage,
+    res: http.ServerResponse,
+  ): Promise<void> {
+    const body = await parseJsonBody<MetaWorkScopeBody & { id?: string; content?: string }>(req);
+    const scope = readMetaWorkScope(body);
+    if (!scope) {
+      sendError(res, 400, "memory_scope_invalid");
+      return;
+    }
+    if (!await this.allowMetaWorkScope(scope, res)) return;
+    const store = this.core.getVectorStore();
+    if (!store || !body.id || typeof body.content !== "string") {
+      sendError(res, 400, "Missing required fields: id, content");
+      return;
+    }
+    const current = (await store.queryL1Records()).find(row => row.record_id === body.id);
+    if (!current) {
+      sendError(res, 404, `memory_asset_not_found: ${body.id}`);
+      return;
+    }
+    const updatedAt = new Date().toISOString();
+    let metadata: Record<string, unknown> = {};
+    try { metadata = JSON.parse(current.metadata_json) as Record<string, unknown>; } catch { /* keep empty */ }
+    const record: MemoryRecord = {
+      id: current.record_id,
+      content: body.content,
+      type: current.type as MemoryRecord["type"],
+      priority: current.priority,
+      scene_name: current.scene_name,
+      source_message_ids: [],
+      metadata,
+      timestamps: [current.timestamp_str || updatedAt],
+      createdAt: current.created_time,
+      updatedAt,
+      sessionKey: current.session_key,
+      sessionId: current.session_id,
+    };
+    if (!(await store.upsertL1(record))) {
+      sendError(res, 500, `memory_asset_update_failed: ${body.id}`);
+      return;
+    }
+    this.sendMetaWorkResponse(res, { id: body.id, version: updatedAt });
+  }
