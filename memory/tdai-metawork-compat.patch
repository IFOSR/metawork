+    if (!await this.allowMetaWorkScope(scope, res)) return;
+    const store = this.core.getVectorStore();
+    const ids = Array.isArray(body.ids) ? body.ids.filter(id => typeof id === "string") : [];
+    const owned = store && ids.length > 0
