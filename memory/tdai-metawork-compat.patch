+    const offset = Math.max(0, body.offset ?? 0);
+    const limit = Math.min(100, Math.max(1, body.limit ?? 100));
+    this.sendMetaWorkResponse(res, { items: items.slice(offset, offset + limit), total: items.length });
+  }
