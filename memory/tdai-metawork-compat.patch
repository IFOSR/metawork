+      this.sendMetaWorkResponse(res, { items: [] });
+      return;
+    }
+    const terms = searchTerms(query);
+    const index = await readMetaWorkSceneIndex(this.config.data.baseDir);
+    const items = index.map(entry => {
+      const haystack = normalizeSearchText(`${entry.filename} ${entry.summary}`);
+      const matches = terms.filter(term => haystack.includes(term)).length;
+      return { entry, matches };
+    }).filter(item => item.matches > 0)
+      .sort((a, b) => b.matches - a.matches
+        || b.entry.heat - a.entry.heat
+        || b.entry.updated.localeCompare(a.entry.updated)
+        || profileId(scope, "l2", a.entry.filename).localeCompare(profileId(scope, "l2", b.entry.filename)))
+      .slice(0, Math.min(5, Math.max(1, body.limit ?? 3)))
+      .map(({ entry, matches }) => ({
+        id: profileId(scope, "l2", entry.filename),
+        title: entry.filename,
+        preview: entry.summary,
+        revision: "", // Filled from the indexed scene file so it pins the exact body.
+        updated_at: entry.updated || null,
+        score: matches,
+      }));
+    for (const item of items) {
+      const entry = index.find(candidate => profileId(scope, "l2", candidate.filename) === item.id);
+      if (!entry) continue;
+      try {
+        const raw = await readIndexedScene(this.config.data.baseDir, entry.filename);
+        item.revision = sha256(parseSceneBlock(raw, entry.filename).content);
+      } catch {
+        item.revision = "";
+      }
+    }
+    this.sendMetaWorkResponse(res, { items: items.filter(item => item.revision) });
+  }
