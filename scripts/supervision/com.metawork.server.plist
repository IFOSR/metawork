<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MetaWork Server launchd template (macOS).
     Install: cp com.metawork.server.plist ~/Library/LaunchAgents/ && edit HOME paths,
     then: launchctl load ~/Library/LaunchAgents/com.metawork.server.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.metawork.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/metawork</string>
    <string>server</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.metawork/server.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.metawork/server.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
