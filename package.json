{
  "name": "metawork",
  "version": "1.2.0-preview.0",
  "description": "A commercial AI Task OS for durable, policy-governed agent workflows.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFOSR/metawork.git"
  },
  "bin": {
    "metawork": "./dist/index.js",
    "anyfusion": "./dist/index.js",
    "metaclaw": "./dist/index.js",
    "metawork-install": "./dist/install-cli.js",
    "anyfusion-install": "./dist/install-cli.js",
    "request_capability": "./dist/capability-request-cli.js",
    "use_capability": "./dist/capability-use-cli.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node dist/generate-planner-schema.js dist/planning-agent-plan-v8.schema.json && node dist/emit-pi-attempt-extension.js dist/pi-attempt-tools.ts && npm run build:web",
    "build:web": "npm ci --prefix web --ignore-scripts && npm run build --prefix web",
    "test": "vitest run",
    "test:task8-contract": "vitest run tests/acceptance/task8-cross-repository-contract.test.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "setup:native": "node scripts/install-native-macos.mjs",
    "package:release": "node scripts/package-release.mjs",
    "smoke:metawork": "node scripts/smoke-metaclaw-real-task.mjs",
    "smoke:anyfusion": "node scripts/smoke-metaclaw-real-task.mjs",
    "smoke:gateway": "node scripts/smoke-unified-gateway.mjs",
    "smoke:clients": "vitest run tests/integration/independent-client-lifecycle.integration.test.ts",
    "smoke:metaclaw": "node scripts/smoke-metaclaw-real-task.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.0",
    "ink": "^5.0.0",
    "js-yaml": "^4.3.0",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "react": "^18.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
