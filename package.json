{
  "name": "metawork",
  "version": "0.1.7",
  "description": "A commercial AI Task OS for durable, policy-governed agent workflows.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IFOSR/metawork.git"
  },
  "bin": {
    "metawork": "./dist/index.js",
    "anyfusion": "./dist/index.js",
    "metaclaw": "./dist/index.js",
    "metawork-install": "./dist/install-cli.js",
    "anyfusion-install": "./dist/install-cli.js",
    "request_capability": "./dist/capability-request-cli.js",
    "use_capability": "./dist/capability-use-cli.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node dist/generate-planner-schema.js dist/planning-agent-plan-v8.schema.json && node dist/emit-pi-attempt-extension.js dist/pi-attempt-tools.ts && node scripts/prepare-pi-pdf.mjs && npm run build:web",
    "build:web": "npm ci --prefix web --ignore-scripts && npm run build --prefix web",
    "test": "vitest run",
    "test:task8-contract": "vitest run tests/acceptance/task8-cross-repository-contract.test.ts",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "setup:native": "node scripts/install-native-macos.mjs",
    "server:start": "node scripts/run-installed-cli.mjs server start",
    "server:stop": "node scripts/run-installed-cli.mjs server stop",
    "server:restart": "node scripts/run-installed-cli.mjs server restart",
    "server:status": "node scripts/run-installed-cli.mjs server status",
    "server:doctor": "node scripts/run-installed-cli.mjs server doctor",
    "package:release": "node scripts/package-release.mjs",
    "build:release": "node scripts/build-release.mjs",
    "smoke:metawork": "node scripts/smoke-metaclaw-real-task.mjs",
    "smoke:anyfusion": "node scripts/smoke-metaclaw-real-task.mjs",
    "smoke:gateway": "node scripts/smoke-unified-gateway.mjs",
    "smoke:query-billing": "node scripts/smoke-query-billing.mjs",
    "smoke:span-routing": "node scripts/smoke-span-routing.mjs",
    "smoke:clients": "vitest run tests/integration/independent-client-lifecycle.integration.test.ts",
    "smoke:metaclaw": "node scripts/smoke-metaclaw-real-task.mjs",
    "start": "node scripts/run-installed-cli.mjs",
    "build:desktop": "npm run build --prefix apps/desktop",
    "lint:desktop": "npm run lint --prefix apps/desktop",
    "test:desktop": "npm run test --prefix apps/desktop",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "smoke:desktop": "node apps/desktop/tests/electron-smoke.mjs",
    "smoke:pi-pdf": "node scripts/smoke-pi-pdf.mjs",
    "benchmark:desktop": "node apps/desktop/tests/startup-benchmark.mjs",
    "package:desktop": "npm run package:mac --prefix apps/desktop"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/sdk": "1.3.32",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dayjs": "^1.11.0",
    "js-yaml": "^4.3.0",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "react": "^18.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.0",
    "@types/react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.9"
}
