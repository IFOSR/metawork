PORT=8780
HOST=127.0.0.1
DATABASE_PATH=./data/official.sqlite
# Generate a random value with at least 32 characters. Do not use this literal.
ADMIN_TOKEN=
# Enable only behind the loopback nginx proxy that overwrites X-Real-IP.
TRUST_PROXY=0
# OpenAI-compatible upstream, configured only on the official host.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# OPC Hub payment gateway. Leave all of PAYMENT_HUB_BASE_URL / PAYMENT_HUB_CLIENT_ID /
# PAYMENT_HUB_CLIENT_SECRET unset to disable payments and refunds entirely; the three
# must be configured together. PAYMENT_NOTIFY_URL is optional (HTTPS public callback;
# without it only poll-based reconciliation works). Only wechat_native is supported.
PAYMENT_HUB_BASE_URL=
PAYMENT_HUB_CLIENT_ID=
PAYMENT_HUB_CLIENT_SECRET=
PAYMENT_NOTIFY_URL=
PAYMENT_CHANNEL=wechat_native
