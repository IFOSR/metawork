PORT=8780
HOST=127.0.0.1
DATABASE_PATH=./data/official.sqlite
# Generate a random value with at least 32 characters. Do not use this literal.
ADMIN_TOKEN=
# Enable only behind the loopback nginx proxy that overwrites X-Real-IP.
TRUST_PROXY=0
# OpenAI-compatible upstream, configured only on the official host.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# OPC Hub gateway for payments (ADR-0048). Leave all of PAYMENT_HUB_BASE_URL /
# PAYMENT_HUB_CLIENT_ID / PAYMENT_HUB_CLIENT_SECRET unset to disable payments and
# refunds entirely; the three must be configured together. PAYMENT_NOTIFY_URL is
# optional (HTTPS public callback; without it only poll-based reconciliation
# works). Only wechat_native is supported.
PAYMENT_HUB_BASE_URL=
PAYMENT_HUB_CLIENT_ID=
PAYMENT_HUB_CLIENT_SECRET=
PAYMENT_NOTIFY_URL=
PAYMENT_CHANNEL=wechat_native
# Generic SMTP for registration verification codes (ADR-0050). All fields are
# required for registration to work; login for existing accounts needs none of
# them. Credentials belong in the K8s Secret, never in code.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 本机邮箱验证码日预算熔断（可选，默认 100/上海自然日，尽力而为）。
EMAIL_DAILY_MAX=
# 实例预配（docs/plans/2026-11-09-official-runtime-provisioning-design.md）。
# RUNTIME_IMAGE 未配置时创建接口返回 instance_unavailable，其余功能不受影响；
# 其余键全部有代码缺省值，按需覆盖。
RUNTIME_IMAGE=
# 免密登录钥匙/门票的 HMAC 密钥（≥32 字符；实例镜像配置时启动强制校验）。
RUNTIME_ACCESS_SECRET=
# 私有仓库拉取凭据（可选）：docker-registry 类型 Secret 名，同 namespace 预先创建。
RUNTIME_IMAGE_PULL_SECRET=
# RUNTIME_RELEASE_ID 已废弃：实例直跑镜像内代码（见 ADR-0056），版本即镜像 tag，
# 该变量不再被容器路径使用；Secret 里遗留的 key 留着无害。
# RUNTIME_BASE_DOMAIN=metawork.nexusfusionai.com
# RUNTIME_NAMESPACE=nexusfusionai
# RUNTIME_PORT=8788
# RUNTIME_TLS_SECRET=metawork-nexusfusionai-com-tls
# RUNTIME_STORAGE_CLASS=cloud-nas-cnfs
# RUNTIME_OPENAI_BASE_URL=
# 用户可选工作目录的根（容器内路径）；留空 = 不限制（与历史行为一致）。
# 设置后实例里的用户只能在它之下浏览/选择/新建工作目录；根目录不存在时实例启动失败。
# 目录落在实例 PVC 的 workspace 子路径上（与 /data 同卷，不额外申请存储）。
# RUNTIME_WORKSPACE_ROOT=/workspace
# RUNTIME_EXPIRE_GRACE_DAYS=1
# RUNTIME_SUSPEND_KEEP_DAYS=30
# RUNTIME_RECYCLE_DAYS=30
# RUNTIME_ACCESS_URL_TTL_SECONDS=60
