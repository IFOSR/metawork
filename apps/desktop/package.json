{
  "name": "@metawork/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "MetaWork desktop client",
  "author": "MetaWork",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node packaging/build.mjs",
    "start": "electron .",
    "lint": "tsc --noEmit",
    "test": "vitest run tests",
    "package:mac": "npm run build && electron-builder --config packaging/electron-builder.config.mjs --mac --publish never",
    "smoke": "node tests/electron-smoke.mjs",
    "prepare:runtime": "node packaging/prepare-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "playwright-core": "1.58.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
