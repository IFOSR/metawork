# SSH server layer on top of the existing metaclaw-tui image.
#
# Why: `docker exec -it` on Windows gives Ink a stdin that isn't a real
# terminal, which crashes the TUI with "Raw mode is not supported". SSH gives a
# genuine PTY, so the Ink TUI works, and the user also gets a general-purpose
# shell for inspecting /workspace output files. The container becomes a
# long-running SSH server you connect to with `ssh` (or VS Code Remote-SSH).
#
# This only adds openssh-server — node, pi, and dist come from the base image
# (Dockerfile.runtime). Build the base first if it's missing; shell.ps1 handles
# that ordering.
#
#   docker build -f docker/Dockerfile.ssh -t metaclaw-tui-ssh .
#
FROM metaclaw-runtime:latest

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssh-server \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /run/sshd \
  && echo 'root:metaclaw' | chpasswd

# Permit root password login (sshd defaults deny it).
RUN sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
  && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config

EXPOSE 22

# Run sshd in the foreground so the container stays up as an SSH server.
CMD ["/usr/sbin/sshd", "-D"]
