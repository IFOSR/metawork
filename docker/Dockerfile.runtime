FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    CI=true \
    METACLAW_HOME=/data/metaclaw \
    METACLAW_PLANNER_CODEX_HOME=/var/lib/metaclaw/codex/planner \
    METACLAW_EXECUTOR_CODEX_HOME=/var/lib/metaclaw/codex/executor \
    METACLAW_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v4.schema.json \
    METACLAW_PLANNER_WORKDIR=/var/empty/metaclaw-planner \
    METACLAW_PLANNER_ENV_FILE=/run/metaclaw/env/planner-codex.env \
    METACLAW_CODEX_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-codex.env \
    METACLAW_PI_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-pi.env

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git openssh-client python3 \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g --ignore-scripts @openai/codex@0.144.1 @earendil-works/pi-coding-agent@0.80.2

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY docker/entrypoint.sh /opt/metaclaw/entrypoint.sh
COPY docker/persist-ssh-environment.sh /opt/metaclaw/persist-ssh-environment.sh
COPY docker/codex-config /opt/metaclaw/codex-config
COPY docker/pi-config /opt/metaclaw/pi-config
COPY docker/tui-config.yaml /opt/metaclaw/default-config.yaml
COPY scripts/smoke-planner-mcp.mjs /app/scripts/smoke-planner-mcp.mjs
COPY scripts/smoke-planner-codex.mjs /app/scripts/smoke-planner-codex.mjs
COPY --from=builder /app/dist/planning-agent-plan-v4.schema.json /opt/metaclaw/schema/planning-agent-plan-v4.schema.json

RUN sed -i 's/\r$//' /opt/metaclaw/entrypoint.sh /opt/metaclaw/persist-ssh-environment.sh \
  && chmod +x /opt/metaclaw/entrypoint.sh \
  && mkdir -p /data/metaclaw /workspace /var/empty/metaclaw-planner

VOLUME ["/data", "/workspace"]
WORKDIR /workspace
ENTRYPOINT ["/opt/metaclaw/entrypoint.sh"]
CMD ["node", "/app/dist/index.js"]
