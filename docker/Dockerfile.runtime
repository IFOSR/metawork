# syntax=docker/dockerfile:1.7

# The Pi engine comes from the pinned upstream release (tools/pi-runtime pins
# the exact @earendil-works/pi-coding-agent version, same source as main's CI
# builds). The kimi/Moonshot request-compat is carried by generated model
# config (compat.supportsDeveloperRole, see agent-runtime-renderer.ts), not by
# a vendored fork — so this image no longer builds planner/AnyFusion-Pi.
FROM node:22.19.0-bookworm-slim AS pi-installer

WORKDIR /build
COPY tools/pi-runtime/package.json tools/pi-runtime/package-lock.json ./
# 国内源：npm 走 npmmirror（构建环境在中国大陆，直连 registry.npmjs.org 不稳定）。
RUN npm ci --ignore-scripts --registry=https://registry.npmmirror.com \
  && mkdir -p /opt/pi \
  && cp -a package.json package-lock.json node_modules /opt/pi/ \
  && printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/node /opt/pi/node_modules/@earendil-works/pi-coding-agent/dist/cli.js "$@"' > /opt/pi/bin/pi \
  && chmod +x /opt/pi/bin/pi

FROM docker:27-cli AS docker-cli

FROM node:22.19.0-bookworm-slim AS builder

# better-sqlite3 falls back to node-gyp when its prebuilt download fails; the
# slim base image ships no Python/build chain, so provide it explicitly.
# 国内源：apt 走阿里云镜像，npm 走 npmmirror。
RUN for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
      [ -f "$f" ] && sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' "$f" || true; \
    done \
  && apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com
COPY . .
# prepare-pi-pdf 从 GitHub releases 下载嵌入式 Python 并用 pip 装依赖；
# 境内直连常超时，分别走加速镜像与 pip 国内源（预置缓存时两项均不触发）。
ENV PI_PDF_ASSET_MIRROR=https://gh-proxy.com/
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUN npm run build

FROM node:22.19.0-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    CI=true \
    ANYFUSION_INSTALL_ROOT=/data/anyfusion \
    METACLAW_HOME=/data/anyfusion/data \
    ANYFUSION_PLANNER_HOME=/var/lib/metaclaw/anyfusion-planner/agent \
    METACLAW_PLANNER_HOME=/var/lib/metaclaw/anyfusion-planner/agent \
    METACLAW_PLANNER_SESSION_DIR=/var/lib/metaclaw/anyfusion-planner/sessions \
    METACLAW_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v9.schema.json \
    ANYFUSION_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v9.schema.json \
    METACLAW_PLANNER_WORKDIR=/workspace \
    METACLAW_PLANNER_ENV_FILE=/run/metaclaw/env/planner-pi.env \
    METACLAW_PLANNER_COMMAND=/usr/local/bin/pi \
    METACLAW_PLANNER_TUI_COMMAND=/usr/local/bin/pi \
    METACLAW_PLANNER_TUI_SOCKET=/data/metaclaw/anyfusion-planner.sock \
    ANYFUSION_BRIDGE_SOCKET=/data/metaclaw/anyfusion-planner.sock \
    ANYFUSION_PLANNER_MODE=1 \
    METACLAW_EXECUTOR_BACKEND=native \
    METACLAW_EXECUTOR_CODEX_HOME=/var/lib/metaclaw/codex/executor \
    METACLAW_EXECUTOR_PI_HOME=/root \
    METACLAW_CODEX_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-codex.env \
    METACLAW_PI_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-pi.env

# 国内源：apt 走阿里云镜像。
RUN for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
      [ -f "$f" ] && sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' "$f" || true; \
    done \
  && apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl fd-find git openssh-client openssh-server python3 ripgrep \
  && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /run/sshd \
  && echo 'root:metaclaw' | chpasswd \
  && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
  && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
  && npm install -g --ignore-scripts --registry=https://registry.npmmirror.com @openai/codex@0.144.1 \
  && ln -sf /opt/pi/bin/pi /usr/local/bin/pi

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/web/dist ./web/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/dist/pi-attempt-tools.ts /opt/metaclaw/pi-attempt-tools.ts
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=pi-installer /opt/pi /opt/pi
COPY docker/entrypoint.sh /opt/metaclaw/entrypoint.sh
COPY docker/persist-ssh-environment.sh /opt/metaclaw/persist-ssh-environment.sh
COPY docker/codex-config/executor /opt/metaclaw/codex-config/executor
COPY docker/pi-config /opt/metaclaw/pi-config
COPY docker/planner-pi-config /opt/metaclaw/planner-pi-config
COPY docker/tui-config.yaml /opt/metaclaw/default-config.yaml
COPY scripts/smoke-planner-mcp.mjs /app/scripts/smoke-planner-mcp.mjs
COPY scripts/smoke-metaclaw-real-task.mjs /app/scripts/smoke-metaclaw-real-task.mjs
COPY --from=builder /app/dist/planning-agent-plan-v9.schema.json /opt/metaclaw/schema/planning-agent-plan-v9.schema.json

RUN test "$(node --version)" = 'v22.19.0' \
  && test -x /opt/pi/bin/pi \
  && test -d /app/node_modules \
  && printf '#!/bin/sh\nexec node /app/dist/capability-request-cli.js "$@"\n' > /usr/local/bin/request_capability \
  && printf '#!/bin/sh\nexec node /app/dist/capability-use-cli.js "$@"\n' > /usr/local/bin/use_capability \
  && sed -i 's/\r$//' /opt/metaclaw/entrypoint.sh /opt/metaclaw/persist-ssh-environment.sh \
  && chmod +x /opt/metaclaw/entrypoint.sh /usr/local/bin/request_capability /usr/local/bin/use_capability \
  && mkdir -p /data/metaclaw /data/anyfusion/data /workspace /var/empty/metaclaw-planner /var/lib/metaclaw/anyfusion-planner/agent /var/lib/metaclaw/anyfusion-planner/sessions

VOLUME ["/data", "/workspace"]
EXPOSE 22
WORKDIR /workspace
ENTRYPOINT ["/opt/metaclaw/entrypoint.sh"]
CMD ["node", "/app/dist/index.js"]
