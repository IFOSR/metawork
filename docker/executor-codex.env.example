# Provider settings used only when MetaClaw spawns Executor Codex.
# Copy this file to docker/executor-codex.env and fill the active provider values.
# The Docker SSH workflow mounts the local file read-only; never commit real keys.

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Retained during the initial split so the three files can be copied unchanged.
# Variables unsupported by this executor are ignored.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Pi-only startup settings are harmless here and retained for copy compatibility.
PI_SKIP_VERSION_CHECK=1
PI_TELEMETRY=0
