# Provider settings used only when MetaClaw spawns Executor Pi.
# Copy this file to docker/executor-pi.env and fill the active provider values.
# The Docker SSH workflow mounts the local file read-only; never commit real keys.

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Sandboxed Pi attempts currently use an OpenAI-compatible endpoint through the
# attempt-scoped model gateway. Do not place other provider credentials here:
# they are intentionally never forwarded into attempt containers.

# Keep Pi startup quieter and less network-chatty.
PI_SKIP_VERSION_CHECK=1
PI_TELEMETRY=0
