# Provider settings used only when MetaClaw spawns Executor Pi.
# Copy this file to docker/executor-pi.env and fill the active provider values.
# The Docker SSH workflow mounts the local file read-only; never commit real keys.

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Alternative providers supported by Pi. Leave unused providers blank or remove.
# The same shape is retained across all three files during the initial split.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Keep Pi startup quieter and less network-chatty.
PI_SKIP_VERSION_CHECK=1
PI_TELEMETRY=0
