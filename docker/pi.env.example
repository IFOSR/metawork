# Single API config entry point for the Docker runtime. Copy to docker/pi.env
# and fill only the provider key you want to use. Loaded via `docker run
# --env-file`, so every var here is available to both codex and pi.
# Never bake real API keys into Dockerfile.test.

# The default model is gpt-5.4 for both codex and pi. To change the supplier,
# edit ONLY the two values below — entrypoint.sh substitutes OPENAI_BASE_URL into
# both docker/codex-config/config.toml and docker/pi-config/models.json at
# container start, and codex/pi read OPENAI_API_KEY from this env.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Alternative providers supported by pi. Leave unused providers blank or remove.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Keep Docker smoke runs quieter and less network-chatty at startup.
PI_SKIP_VERSION_CHECK=1
PI_TELEMETRY=0
